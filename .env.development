NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100


DATABASE_URL=postgresql://whycode:postgres@localhost:5432/whycode?schema=public

SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whycode_shadow?schema=public

SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=WhyCODE API
SWAGGER_DESCRIPTION=Production-grade NestJS API (WhyCODE)
SWAGGER_VERSION=1.0

# GitHub OAuth placeholders (safe for git). Real local secrets go in
# .env.development.local (gitignored) which overrides this file.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
GITHUB_SCOPE=read:user user:email repo
FRONTEND_URL=http://localhost:4000

# Placeholder secrets that pass validation. Override in .env.development.local.
JWT_SECRET=please_set_a_32_plus_char_secret_for_dev_only_123
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM for investigations (free key at https://aistudio.google.com).
# Put your real key in .env.development.local; this stays empty.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=60000
