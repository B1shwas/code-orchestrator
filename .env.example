# Copy this file to .env and adjust values for local development
# cp .env.example .env

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Postgres — e.g. postgresql://postgres:postgres@localhost:5432/whycode?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whycode?schema=public
# Scratch DB for `prisma migrate diff` / `migrate dev` planning only (never used at runtime)
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whycode_shadow?schema=public

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=WhyCODE API
SWAGGER_DESCRIPTION=Production-grade NestJS API (WhyCODE)
SWAGGER_VERSION=1.0

# GitHub OAuth (GitHub-only auth). Create at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
GITHUB_SCOPE=read:user user:email repo
FRONTEND_URL=http://localhost:3000

# App JWT for sessions (Bearer). Generate: openssl rand -base64 48
JWT_SECRET=please_set_a_32_plus_char_secret_for_dev_only_123
JWT_EXPIRES_IN=7d

# 32-byte hex key for AES-256-GCM encryption of User.githubToken. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
