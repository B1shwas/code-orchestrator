generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String  @id @default(uuid())
  githubId    String  @unique
  email       String?
  name        String?
  avatarUrl   String?
  githubToken String

  repositoryLinks UserRepository[]
  investigations  Investigation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Repository {
  id String @id @default(uuid())

  githubRepoId  Int     @unique
  owner         String
  name          String
  cloneUrl      String
  defaultBranch String  @default("main")

  localPath    String
  status       RepoStatus @default(PENDING)
  errorMessage String?

  sizeBytes BigInt?
  stage     String?
  progress  Int?

  members        UserRepository[]
  investigations Investigation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([owner, name])
  @@map("repositories")
}

model UserRepository {
  id           String @id @default(uuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
  @@map("user_repositories")
}

enum RepoStatus {
  PENDING
  CLONING
  READY
  ERROR
}

model Investigation {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  query        String
  targetFile   String?
  targetSymbol String?
  mode         String  @default("why")

  status      InvestigationStatus @default(PENDING)
  evidence    Json?
  result      Json?
  llmResponse String?

  evidenceItems EvidenceItem[]
  steps         InvestigationStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("investigations")
}

enum InvestigationStatus {
  PENDING
  GATHERING_EVIDENCE
  ANALYZING
  COMPLETED
  PARTIAL
  INSUFFICIENT
  FAILED
}

model EvidenceItem {
  id              String        @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  kind    EvidenceKind
  ref     String
  excerpt String         @db.VarChar(500)
  grade   EvidenceGrade

  createdAt DateTime @default(now())

  @@index([investigationId])
  @@map("evidence_items")
}

enum EvidenceKind {
  code
  commit
  diff
  pr
  issue
}

enum EvidenceGrade {
  confirmed
  supported
  inferred
}

model InvestigationStep {
  id              String        @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  seq     Int
  kind    StepKind
  payload Json

  createdAt DateTime @default(now())

  @@unique([investigationId, seq])
  @@index([investigationId])
  @@map("investigation_steps")
}

enum StepKind {
  prompt
  tool
  verdict
  repair
  status
}
